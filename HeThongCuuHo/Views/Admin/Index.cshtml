@{
    Layout = null;
    ViewData["Title"] = "Admin Dashboard";

    var cuaHangsJson = System.Text.Json.JsonSerializer.Serialize(
        ViewBag.CuaHangs ?? new List<object>()
    );
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NHA TRANG RESCUE - Admin</title>

    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                background: #f5f6fa;
                font-family: 'Inter', sans-serif;
                color: #252b36;
            }

            .sidebar {
                width: 260px;
                height: 100vh;
                position: fixed;
                top: 0;
                left: 0;
                background: #182638;
                color: white;
                padding: 25px 18px;
                z-index: 100;
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 5px 10px 35px;
            }

            .brand-icon {
                width: 42px;
                height: 42px;
                border-radius: 12px;
                background: #e53935;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 21px;
            }

            .brand h4 {
                font-size: 16px;
                font-weight: 800;
                margin: 0;
            }

            .brand small {
                color: #aab5c4;
                font-size: 10px;
                letter-spacing: 1px;
            }

            .menu-title {
                color: #8491a3;
                font-size: 10px;
                font-weight: 700;
                margin: 22px 12px 12px;
                letter-spacing: 1px;
            }

            .menu-item {
                display: flex;
                align-items: center;
                gap: 13px;
                padding: 13px 14px;
                border-radius: 9px;
                color: #b9c3d0;
                text-decoration: none;
                font-size: 13px;
                margin-bottom: 5px;
                transition: .2s;
            }

                .menu-item i {
                    width: 18px;
                }

                .menu-item.active,
                .menu-item:hover {
                    background: #e53935;
                    color: white;
                }

            .main {
                margin-left: 260px;
                padding: 30px 35px;
            }

            .topbar {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 30px;
            }

                .topbar h2 {
                    font-size: 23px;
                    font-weight: 800;
                    margin: 0;
                }

                .topbar p {
                    color: #8992a1;
                    font-size: 12px;
                    margin: 7px 0 0;
                }

            .admin-info {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .avatar {
                width: 42px;
                height: 42px;
                border-radius: 50%;
                background: #ffe4e3;
                color: #e53935;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .admin-info strong {
                display: block;
                font-size: 13px;
            }

            .admin-info small {
                color: #929aaa;
                font-size: 11px;
            }

            .welcome {
                background: linear-gradient(110deg, #e53935, #bd2525);
                border-radius: 15px;
                padding: 28px 30px;
                color: white;
                margin-bottom: 28px;
            }

                .welcome h3 {
                    font-size: 20px;
                    font-weight: 800;
                    margin-bottom: 9px;
                }

                .welcome p {
                    font-size: 12px;
                    margin: 0;
                    opacity: .9;
                }

            .section-heading {
                font-size: 16px;
                font-weight: 700;
                margin-bottom: 17px;
            }

       
            .map-container {
                background: white;
                padding: 22px;
                border-radius: 15px;
                margin-bottom: 28px;
                border: 1px solid #edf0f4;
                box-shadow: 0 2px 12px rgba(0,0,0,0.05);
            }

            .map-description {
                color: #8992a1;
                font-size: 12px;
                margin-top: -8px;
                margin-bottom: 16px;
            }

            #map {
                width: 100%;
                height: 400px;
                border-radius: 12px;
                z-index: 1;
            }

            .stat-card {
                background: white;
                padding: 22px;
                border-radius: 13px;
                border: 1px solid #edf0f4;
                height: 100%;
                transition: .2s;
            }

                .stat-card:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 8px 25px rgba(0,0,0,.05);
                }

            .stat-icon {
                width: 43px;
                height: 43px;
                border-radius: 11px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 17px;
                margin-bottom: 18px;
            }

            .red {
                background: #ffe8e7;
                color: #e53935;
            }

            .blue {
                background: #e7f0ff;
                color: #3975d7;
            }

            .green {
                background: #e4f8ef;
                color: #21a56b;
            }

            .orange {
                background: #fff1df;
                color: #e99a2c;
            }

            .purple {
                background: #f0eaff;
                color: #8254d9;
            }

            .cyan {
                background: #e2f7fa;
                color: #1599aa;
            }

            .stat-label {
                color: #8992a1;
                font-size: 12px;
                margin-bottom: 8px;
            }

            .stat-number {
                font-size: 27px;
                font-weight: 800;
            }

            .content-card {
                background: white;
                border: 1px solid #edf0f4;
                border-radius: 13px;
                padding: 23px;
                height: 100%;
            }

            .quick-action {
                display: flex;
                align-items: center;
                gap: 13px;
                padding: 15px;
                border: 1px solid #edf0f4;
                border-radius: 10px;
                margin-bottom: 12px;
                color: #303846;
                text-decoration: none;
            }

                .quick-action i {
                    color: #e53935;
                    font-size: 17px;
                    width: 22px;
                }

                .quick-action strong {
                    font-size: 12px;
                }

                .quick-action small {
                    display: block;
                    color: #929aaa;
                    font-size: 10px;
                    margin-top: 4px;
                }

                .quick-action:hover {
                    border-color: #e53935;
                    background: #fffafa;
                }

            .sidebar-bottom {
                position: absolute;
                bottom: 20px;
                left: 18px;
                right: 18px;
                border-top: 1px solid #354253;
                padding-top: 15px;
            }

            .logout-btn {
                width: 100%;
                border: 0;
                background: transparent;
                color: #ffaaaa;
                text-align: left;
                padding: 10px 14px;
                font-size: 13px;
            }

                .logout-btn:hover {
                    color: white;
                }

            @@media (max-width: 900px) {
                .sidebar {
                    width: 75px;
                    padding: 20px 10px;
                }

                .brand {
                    justify-content: center;
                    padding: 5px 0 30px;
                }

                .brand-text,
                .menu-title,
                .menu-item span {
                    display: none;
                }

                .menu-item {
                    justify-content: center;
                    padding: 14px 5px;
                }

                .main {
                    margin-left: 75px;
                    padding: 25px 20px;
                }

                .sidebar-bottom {
                    left: 8px;
                    right: 8px;
                }

                .logout-btn {
                    text-align: center;
                }
            }

            @@media (max-width: 600px) {
                .main {
                    padding: 20px 13px;
                }

                .topbar h2 {
                    font-size: 18px;
                }

                .admin-info .admin-text {
                    display: none;
                }

                .welcome {
                    padding: 22px;
                }

                .map-container {
                    padding: 15px;
                }

                #map {
                    height: 320px;
                }
            }
    </style>
</head>

<body>

    
    <aside class="sidebar">

        <div class="brand">
            <div class="brand-icon">
                <i class="fa-solid fa-plus"></i>
            </div>

            <div class="brand-text">
                <h4>NHA TRANG</h4>
                <small>RESCUE SYSTEM</small>
            </div>
        </div>

        <div class="menu-title">QUẢN LÝ CHUNG</div>

        <a href="/Admin/Index" class="menu-item active">
            <i class="fa-solid fa-chart-pie"></i>
            <span>Tổng quan</span>
        </a>

        <div class="menu-title">QUẢN LÝ HỆ THỐNG</div>

        <a href="/QuanLyTaiKhoan/Index" class="menu-item">
            <i class="fa-solid fa-users"></i>
            <span>Tài khoản</span>
        </a>

        <a href="#" class="menu-item">
            <i class="fa-solid fa-user-group"></i>
            <span>Khách hàng</span>
        </a>

        <a href="#" class="menu-item">
            <i class="fa-solid fa-shop"></i>
            <span>Cửa hàng sửa chữa</span>
        </a>

        <a href="#" class="menu-item">
            <i class="fa-solid fa-user-tie"></i>
            <span>Nhân viên</span>
        </a>

        <a href="#" class="menu-item">
            <i class="fa-solid fa-car"></i>
            <span>Phương tiện</span>
        </a>

        <a href="#" class="menu-item">
            <i class="fa-solid fa-screwdriver-wrench"></i>
            <span>Dịch vụ</span>
        </a>

        <div class="menu-title">CỨU HỘ VÀ VẬN HÀNH</div>

        <a href="#" class="menu-item">
            <i class="fa-solid fa-truck-fast"></i>
            <span>Yêu cầu cứu hộ</span>
        </a>

        <a href="#" class="menu-item">
            <i class="fa-solid fa-file-invoice-dollar"></i>
            <span>Thanh toán</span>
        </a>

        <div class="sidebar-bottom">
            <form asp-controller="TaiKhoan" asp-action="DangXuat" method="post">
                @Html.AntiForgeryToken()

                <button type="submit" class="logout-btn">
                    <i class="fa-solid fa-right-from-bracket me-2"></i>
                    <span>Đăng xuất</span>
                </button>
            </form>
        </div>

    </aside>

    <main class="main">

        <div class="topbar">
            <div>
                <h2>Tổng quan</h2>
                <p>Chào mừng bạn đến với hệ thống quản trị NHA TRANG RESCUE.</p>
            </div>

            <div class="admin-info">
                <div class="avatar">
                    <i class="fa-solid fa-user-shield"></i>
                </div>

                <div class="admin-text">
                    <strong>@User.Identity?.Name</strong>
                    <small>Quản trị viên</small>
                </div>
            </div>
        </div>

 
        <section class="welcome">
            <h3>Xin chào, Quản trị viên!</h3>
            <p>
                Quản lý và theo dõi hoạt động hệ thống cứu hộ xe Nha Trang tại đây.
            </p>
        </section>


        <div class="map-container">
            <h5 class="section-heading">
                <i class="fa-solid fa-map-location-dot me-2"></i>
                Vị trí các cửa hàng
            </h5>

            <p class="map-description">
                Pin cửa hàng chỉ xuất hiện khi phóng to bản đồ đến khu vực tỉnh/thành phố.
            </p>

            <div id="map"></div>
        </div>

    
        <h5 class="section-heading">Thống kê hệ thống</h5>

        <div class="row g-3 mb-4">

            <div class="col-12 col-sm-6 col-xl-4">
                <div class="stat-card">
                    <div class="stat-icon red">
                        <i class="fa-solid fa-users"></i>
                    </div>
                    <div class="stat-label">Tổng tài khoản</div>
                    <div class="stat-number">@ViewBag.SoTaiKhoan</div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-4">
                <div class="stat-card">
                    <div class="stat-icon blue">
                        <i class="fa-solid fa-user-group"></i>
                    </div>
                    <div class="stat-label">Khách hàng</div>
                    <div class="stat-number">@ViewBag.SoKhachHang</div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-4">
                <div class="stat-card">
                    <div class="stat-icon green">
                        <i class="fa-solid fa-shop"></i>
                    </div>
                    <div class="stat-label">Cửa hàng sửa chữa</div>
                    <div class="stat-number">@ViewBag.SoCuaHang</div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-4">
                <div class="stat-card">
                    <div class="stat-icon orange">
                        <i class="fa-solid fa-user-tie"></i>
                    </div>
                    <div class="stat-label">Nhân viên</div>
                    <div class="stat-number">@ViewBag.SoNhanVien</div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-4">
                <div class="stat-card">
                    <div class="stat-icon purple">
                        <i class="fa-solid fa-car"></i>
                    </div>
                    <div class="stat-label">Phương tiện</div>
                    <div class="stat-number">@ViewBag.SoPhuongTien</div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-4">
                <div class="stat-card">
                    <div class="stat-icon cyan">
                        <i class="fa-solid fa-screwdriver-wrench"></i>
                    </div>
                    <div class="stat-label">Dịch vụ</div>
                    <div class="stat-number">@ViewBag.SoDichVu</div>
                </div>
            </div>

        </div>

 
        <div class="row g-3">
            <div class="col-12">
                <div class="content-card">
                    <h5 class="section-heading">Quản lý hệ thống</h5>

                    <a href="#" class="quick-action">
                        <i class="fa-solid fa-users"></i>
                        <div>
                            <strong>Quản lý tài khoản</strong>
                            <small>Xem và quản lý tài khoản người dùng</small>
                        </div>
                    </a>

                    <a href="#" class="quick-action">
                        <i class="fa-solid fa-shop"></i>
                        <div>
                            <strong>Quản lý cửa hàng</strong>
                            <small>Quản lý các cửa hàng sửa chữa trong hệ thống</small>
                        </div>
                    </a>

                    <a href="#" class="quick-action">
                        <i class="fa-solid fa-screwdriver-wrench"></i>
                        <div>
                            <strong>Quản lý dịch vụ</strong>
                            <small>Cập nhật danh sách dịch vụ cứu hộ và sửa chữa</small>
                        </div>
                    </a>
                </div>
            </div>
        </div>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
            const cuaHangs = @Html.Raw(cuaHangsJson);


            const map = L.map('map').setView([12.2388, 109.1967], 8);


            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors',
                maxZoom: 19
            }).addTo(map);

            const markers = [];

  
            cuaHangs.forEach(function (ch) {

                const viDo = Number(ch.viDo);
                const kinhDo = Number(ch.kinhDo);

                if (!Number.isFinite(viDo) || !Number.isFinite(kinhDo)) {
                    return;
                }

                const marker = L.marker([viDo, kinhDo]);

                const popup = document.createElement('div');

                const ten = document.createElement('strong');
                ten.textContent = ch.tenCH || 'Cửa hàng';

                const diaChi = document.createElement('p');
                diaChi.textContent = 'Địa chỉ: ' + (ch.diaChi || 'Chưa có');

                const sdt = document.createElement('p');
                sdt.textContent = 'Điện thoại: ' + (ch.soDienThoai || 'Chưa có');

                popup.appendChild(ten);
                popup.appendChild(diaChi);
                popup.appendChild(sdt);

                marker.bindPopup(popup);

                markers.push(marker);
            });

   
            const markerGroup = L.featureGroup(markers);

           
            const MIN_ZOOM_SHOW_MARKERS = 11;

    
            function capNhatMarker() {

                const zoom = map.getZoom();

                if (zoom >= MIN_ZOOM_SHOW_MARKERS) {

                    if (!map.hasLayer(markerGroup)) {
                        markerGroup.addTo(map);
                    }

                } else {

                    if (map.hasLayer(markerGroup)) {
                        map.removeLayer(markerGroup);
                    }

                }
            }

            
            map.on('zoomend', capNhatMarker);

     
            capNhatMarker();

          
            setTimeout(function () {
                map.invalidateSize();
            }, 300);
    </script>

</body>
</html>
