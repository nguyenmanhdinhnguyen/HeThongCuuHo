@model HeThongCuuHo.Models.ChuCuaHangDashboardViewModel

@{
    Layout = null;
    ViewData["Title"] = "Quản lý cửa hàng";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>NHA TRANG RESCUE | Quản lý cửa hàng</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                background: #f5f6fa;
                color: #252b36;
                font-family: 'Inter', sans-serif;
                font-size: 13px;
            }

            /* SIDEBAR */
            .sidebar {
                width: 260px;
                height: 100vh;
                position: fixed;
                top: 0;
                left: 0;
                background: #182638;
                padding: 25px 16px;
                color: white;
                z-index: 1000;
                overflow-y: auto;
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 11px;
                padding: 0 10px;
                margin-bottom: 35px;
            }

            .brand-icon {
                width: 38px;
                height: 38px;
                background: #e53935;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
            }

            .brand-name {
                font-size: 15px;
                font-weight: 800;
                letter-spacing: .3px;
                line-height: 1.4;
            }

                .brand-name span {
                    display: block;
                    font-size: 9px;
                    color: #aab7c8;
                    letter-spacing: 1.5px;
                    font-weight: 600;
                }

            .menu-title {
                color: #8291a5;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 1px;
                padding: 15px 12px 9px;
            }

            .menu-item {
                display: flex;
                align-items: center;
                gap: 13px;
                padding: 13px 14px;
                border-radius: 9px;
                margin-bottom: 5px;
                color: #c2ccda;
                text-decoration: none;
                font-size: 12px;
                font-weight: 500;
                transition: .2s;
            }

                .menu-item i {
                    width: 17px;
                    text-align: center;
                    font-size: 14px;
                }

                .menu-item:hover {
                    background: #293c53;
                    color: white;
                }

                .menu-item.active {
                    background: #e53935;
                    color: white;
                }

            .logout-btn {
                width: 100%;
                background: transparent;
                border: none;
                text-align: left;
                cursor: pointer;
            }

            /* MAIN */
            .main {
                margin-left: 260px;
                padding: 30px 35px;
                min-height: 100vh;
            }

            /* TOPBAR */
            .topbar {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 25px;
            }

            .page-title {
                font-size: 23px;
                font-weight: 800;
                margin: 0;
                color: #252b36;
            }

            .page-subtitle {
                color: #8a94a3;
                font-size: 12px;
                margin-top: 6px;
            }

            .profile {
                display: flex;
                align-items: center;
                gap: 11px;
                background: white;
                padding: 9px 15px;
                border: 1px solid #edf0f4;
                border-radius: 11px;
                box-shadow: 0 3px 15px rgba(0,0,0,.035);
            }

            .avatar {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                background: #fde8e7;
                color: #e53935;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 16px;
            }

            .profile-name {
                font-size: 12px;
                font-weight: 700;
            }

            .profile-role {
                font-size: 10px;
                color: #929baa;
                margin-top: 3px;
            }

            /* WELCOME */
            .welcome {
                background: linear-gradient(110deg, #e53935, #bd2525);
                border-radius: 15px;
                padding: 28px 30px;
                color: white;
                margin-bottom: 25px;
                position: relative;
                overflow: hidden;
            }

                .welcome h2 {
                    font-size: 20px;
                    font-weight: 800;
                    margin-bottom: 8px;
                }

                .welcome p {
                    margin: 0 0 18px;
                    font-size: 12px;
                    color: rgba(255,255,255,.85);
                }

                .welcome::after {
                    content: "\f1b9";
                    font-family: "Font Awesome 6 Free";
                    font-weight: 900;
                    position: absolute;
                    right: 45px;
                    top: 50%;
                    transform: translateY(-50%);
                    font-size: 95px;
                    color: rgba(255,255,255,.13);
                }

            .shop-status {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                font-size: 11px;
                font-weight: 600;
                padding: 8px 12px;
                border-radius: 7px;
                background: rgba(255,255,255,.16);
            }

            /* SECTION */
            .section-heading {
                font-size: 15px;
                font-weight: 800;
                margin: 0 0 16px;
            }

            /* INFORMATION CARDS */
            .info-card {
                background: white;
                border: 1px solid #edf0f4;
                border-radius: 13px;
                padding: 22px;
                height: 100%;
                box-shadow: 0 3px 15px rgba(0,0,0,.035);
                transition: .2s;
            }

                .info-card:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 8px 22px rgba(0,0,0,.06);
                }

            .info-icon {
                width: 43px;
                height: 43px;
                border-radius: 11px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #fdebea;
                color: #e53935;
                font-size: 17px;
                margin-bottom: 14px;
            }

            .info-label {
                color: #929baa;
                font-size: 11px;
                font-weight: 500;
                margin-bottom: 8px;
            }

            .info-value {
                color: #252b36;
                font-size: 13px;
                font-weight: 700;
                overflow-wrap: anywhere;
                line-height: 1.6;
            }

            /* FUNCTION CARDS */
            .function-card {
                display: block;
                background: white;
                border: 1px solid #edf0f4;
                border-radius: 13px;
                padding: 22px;
                height: 100%;
                box-shadow: 0 3px 15px rgba(0,0,0,.035);
                transition: .2s;
                text-decoration: none;
                color: inherit;
            }

                .function-card:hover {
                    transform: translateY(-4px);
                    box-shadow: 0 8px 25px rgba(0,0,0,.07);
                    color: inherit;
                }

            .function-icon {
                width: 45px;
                height: 45px;
                border-radius: 11px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #fdebea;
                color: #e53935;
                font-size: 18px;
                margin-bottom: 15px;
            }

            .function-card h6 {
                font-size: 13px;
                font-weight: 800;
                margin-bottom: 8px;
            }

            .function-card p {
                font-size: 11px;
                color: #929baa;
                line-height: 1.7;
                margin: 0;
            }

            .function-footer {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-top: 15px;
                padding-top: 12px;
                border-top: 1px solid #f0f2f5;
            }

                .function-footer span {
                    font-size: 10px;
                    color: #929baa;
                }

                .function-footer i {
                    font-size: 11px;
                    color: #e53935;
                }

            /* RESPONSIVE */
            @@media(max-width: 1100px) {
                .main {
                    padding: 25px 20px;
                }
            }

            @@media(max-width: 900px) {
                .sidebar {
                    width: 75px;
                    padding: 20px 8px;
                }

                .brand {
                    justify-content: center;
                    padding: 0;
                }

                .brand-name,
                .menu-title,
                .menu-item span {
                    display: none;
                }

                .menu-item {
                    justify-content: center;
                    padding: 14px 5px;
                }

                    .menu-item i {
                        font-size: 17px;
                    }

                .main {
                    margin-left: 75px;
                    padding: 22px 18px;
                }
            }

            @@media(max-width: 600px) {
                .main {
                    padding: 18px 12px;
                }

                .page-title {
                    font-size: 18px;
                }

                .welcome {
                    padding: 22px;
                }

                    .welcome h2 {
                        font-size: 17px;
                    }

                    .welcome::after {
                        right: 12px;
                        font-size: 55px;
                    }

                .profile-text {
                    display: none;
                }

                .info-card,
                .function-card {
                    padding: 17px;
                }
            }
    </style>
</head>

<body>

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <div class="brand">
            <div class="brand-icon">
                <i class="fa-solid fa-truck-fast"></i>
            </div>

            <div class="brand-name">
                NHA TRANG RESCUE
                <span>GARAGE MANAGEMENT</span>
            </div>
        </div>

        <div class="menu-title">QUẢN LÝ CỬA HÀNG</div>

        <a href="/QuanLyCuaHang/Index" class="menu-item active">
            <i class="fa-solid fa-chart-pie"></i>
            <span>Tổng quan</span>
        </a>

        <a href="/QuanLyCuaHang/YeuCauCuuHo" class="menu-item">
            <i class="fa-solid fa-truck-medical"></i>
            <span>Yêu cầu cứu hộ</span>
        </a>

        <a href="/QuanLyCuaHang/DonSuaChua" class="menu-item">
            <i class="fa-solid fa-screwdriver-wrench"></i>
            <span>Đơn sửa chữa</span>
        </a>

        <a href="/QuanLyCuaHang/NhanVien" class="menu-item">
            <i class="fa-solid fa-users"></i>
            <span>Nhân viên</span>
        </a>

        <a href="/QuanLyCuaHang/DichVu" class="menu-item">
            <i class="fa-solid fa-list-check"></i>
            <span>Quản lý dịch vụ</span>
        </a>

        <div class="menu-title">CỬA HÀNG</div>

        <a href="/QuanLyCuaHang/ThongTin" class="menu-item">
            <i class="fa-solid fa-store"></i>
            <span>Thông tin cửa hàng</span>
        </a>

        <div class="menu-title">TÀI KHOẢN</div>

        <form asp-controller="TaiKhoan"
              asp-action="DangXuat"
              method="post">

            @Html.AntiForgeryToken()

            <button type="submit" class="menu-item logout-btn">
                <i class="fa-solid fa-right-from-bracket"></i>
                <span>Đăng xuất</span>
            </button>
        </form>

    </aside>

    <!-- MAIN -->
    <main class="main">

        <!-- TOPBAR -->
        <div class="topbar">

            <div>
                <h1 class="page-title">Tổng quan cửa hàng</h1>
                <div class="page-subtitle">
                    Quản lý hoạt động kinh doanh của cửa hàng
                </div>
            </div>

            <div class="profile">

                <div class="avatar">
                    <i class="fa-solid fa-shop"></i>
                </div>

                <div class="profile-text">
                    <div class="profile-name">@Model.TenCuaHang</div>
                    <div class="profile-role">Chủ cửa hàng</div>
                </div>

            </div>

        </div>

        <!-- WELCOME -->
        <section class="welcome">

            <h2>Chào mừng đến với hệ thống quản lý!</h2>

            <p>
                Theo dõi hoạt động và quản lý cửa hàng
                của bạn trên NHA TRANG RESCUE.
            </p>

            <div class="shop-status">

                @if (Model.TrangThai)
                {
                    <i class="fa-solid fa-circle-check"></i>
                    <span>Cửa hàng đang hoạt động</span>
                }
                else
                {
                    <i class="fa-solid fa-circle-xmark"></i>
                    <span>Cửa hàng đang tạm ngưng</span>
                }

            </div>

        </section>

        <!-- SHOP INFORMATION -->
        <h5 class="section-heading">Thông tin cửa hàng</h5>

        <div class="row g-3 mb-4">

            <div class="col-md-4">
                <div class="info-card">

                    <div class="info-icon">
                        <i class="fa-solid fa-shop"></i>
                    </div>

                    <div class="info-label">Tên cửa hàng</div>
                    <div class="info-value">@Model.TenCuaHang</div>

                </div>
            </div>

            <div class="col-md-4">
                <div class="info-card">

                    <div class="info-icon">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>

                    <div class="info-label">Địa chỉ</div>
                    <div class="info-value">@Model.DiaChi</div>

                </div>
            </div>

            <div class="col-md-4">
                <div class="info-card">

                    <div class="info-icon">
                        <i class="fa-solid fa-phone"></i>
                    </div>

                    <div class="info-label">Số điện thoại</div>

                    <div class="info-value">
                        @(string.IsNullOrEmpty(Model.SoDienThoai)
                            ? "Chưa cập nhật"
                            : Model.SoDienThoai)
                    </div>

                </div>
            </div>

        </div>

        <!-- FUNCTIONS -->
        <h5 class="section-heading">Chức năng quản lý</h5>

        <div class="row g-3">

            <div class="col-md-4">
                <a href="/QuanLyCuaHang/YeuCauCuuHo" class="function-card">

                    <div class="function-icon">
                        <i class="fa-solid fa-truck-medical"></i>
                    </div>

                    <h6>Yêu cầu cứu hộ</h6>

                    <p>
                        Xem và tiếp nhận các yêu cầu cứu hộ
                        được gửi đến cửa hàng.
                    </p>

                    <div class="function-footer">
                        <span>Quản lý yêu cầu</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>

                </a>
            </div>

            <div class="col-md-4">
                <a href="/QuanLyCuaHang/DonSuaChua" class="function-card">

                    <div class="function-icon">
                        <i class="fa-solid fa-screwdriver-wrench"></i>
                    </div>

                    <h6>Quản lý sửa chữa</h6>

                    <p>
                        Theo dõi phương tiện, tiến độ sửa chữa
                        và tình trạng đơn hàng.
                    </p>

                    <div class="function-footer">
                        <span>Quản lý đơn sửa chữa</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>

                </a>
            </div>

            <div class="col-md-4">
                <a href="/QuanLyCuaHang/NhanVien" class="function-card">

                    <div class="function-icon">
                        <i class="fa-solid fa-users"></i>
                    </div>

                    <h6>Quản lý nhân viên</h6>

                    <p>
                        Quản lý danh sách nhân viên và
                        phân công công việc.
                    </p>

                    <div class="function-footer">
                        <span>Quản lý nhân sự</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>

                </a>
            </div>

            <div class="col-md-4">
                <a href="/QuanLyCuaHang/DichVu" class="function-card">

                    <div class="function-icon">
                        <i class="fa-solid fa-list-check"></i>
                    </div>

                    <h6>Quản lý dịch vụ</h6>

                    <p>
                        Cập nhật danh sách dịch vụ và
                        giá sửa chữa của cửa hàng.
                    </p>

                    <div class="function-footer">
                        <span>Quản lý dịch vụ</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>

                </a>
            </div>

            <div class="col-md-4">
                <a href="/QuanLyCuaHang/HoaDon" class="function-card">

                    <div class="function-icon">
                        <i class="fa-solid fa-file-invoice-dollar"></i>
                    </div>

                    <h6>Hóa đơn và giao dịch</h6>

                    <p>
                        Theo dõi hóa đơn và lịch sử
                        thanh toán của khách hàng.
                    </p>

                    <div class="function-footer">
                        <span>Quản lý giao dịch</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>

                </a>
            </div>

            <div class="col-md-4">
                <a href="/QuanLyCuaHang/ThongTin" class="function-card">

                    <div class="function-icon">
                        <i class="fa-solid fa-store"></i>
                    </div>

                    <h6>Thông tin cửa hàng</h6>

                    <p>
                        Cập nhật thông tin và trạng thái
                        hoạt động của cửa hàng.
                    </p>

                    <div class="function-footer">
                        <span>Thông tin cửa hàng</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>

                </a>
            </div>

        </div>

        <div class="text-center mt-4 mb-2"
             style="color:#a0a8b4;font-size:10px;">
            NHA TRANG RESCUE © 2026
        </div>

    </main>

</body>
</html>
