@model List<HeThongCuuHo.Models.QuanLyTaiKhoanViewModel>

@{
    Layout = null;
    ViewData["Title"] = "Quản lý tài khoản";

    int tongTaiKhoan = ViewBag.TongTaiKhoan ?? 0;
    int soKhachHang = ViewBag.SoKhachHang ?? 0;
    int soChuCuaHang = ViewBag.SoChuCuaHang ?? 0;
    int dangHoatDong = ViewBag.DangHoatDong ?? 0;
    int daKhoa = ViewBag.DaKhoa ?? 0;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NHA TRANG RESCUE - Quản lý tài khoản</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                background: #f5f6fa;
                font-family: 'Inter', sans-serif;
                color: #252b36;
            }

            .sidebar {
                width: 260px;
                height: 100vh;
                position: fixed;
                top: 0;
                left: 0;
                background: #182638;
                color: white;
                padding: 25px 18px;
                z-index: 100;
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 5px 10px 35px;
            }

            .brand-icon {
                width: 42px;
                height: 42px;
                border-radius: 12px;
                background: #e53935;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 21px;
            }

            .brand h4 {
                font-size: 16px;
                font-weight: 800;
                margin: 0;
            }

            .brand small {
                color: #aab5c4;
                font-size: 10px;
                letter-spacing: 1px;
            }

            .menu-title {
                color: #8491a3;
                font-size: 10px;
                font-weight: 700;
                margin: 22px 12px 12px;
                letter-spacing: 1px;
            }

            .menu-item {
                display: flex;
                align-items: center;
                gap: 13px;
                padding: 13px 14px;
                border-radius: 9px;
                color: #b9c3d0;
                text-decoration: none;
                font-size: 13px;
                margin-bottom: 5px;
                transition: .2s;
            }

                .menu-item i {
                    width: 18px;
                }

                .menu-item.active,
                .menu-item:hover {
                    background: #e53935;
                    color: white;
                }

            .main {
                margin-left: 260px;
                padding: 30px 35px;
            }

            .topbar {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 30px;
            }

                .topbar h2 {
                    font-size: 23px;
                    font-weight: 800;
                    margin: 0;
                }

                .topbar p {
                    color: #8992a1;
                    font-size: 12px;
                    margin: 7px 0 0;
                }

            .admin-info {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .avatar {
                width: 42px;
                height: 42px;
                border-radius: 50%;
                background: #ffe4e3;
                color: #e53935;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .admin-info strong {
                display: block;
                font-size: 13px;
            }

            .admin-info small {
                color: #929aaa;
                font-size: 11px;
            }

            .welcome {
                background: linear-gradient(110deg, #e53935, #bd2525);
                border-radius: 15px;
                padding: 28px 30px;
                color: white;
                margin-bottom: 28px;
            }

                .welcome h3 {
                    font-size: 20px;
                    font-weight: 800;
                    margin-bottom: 9px;
                }

                .welcome p {
                    font-size: 12px;
                    margin: 0;
                    opacity: .9;
                }

            .section-heading {
                font-size: 16px;
                font-weight: 700;
                margin-bottom: 17px;
            }

            .stat-card {
                background: white;
                padding: 22px;
                border-radius: 13px;
                border: 1px solid #edf0f4;
                height: 100%;
                transition: .2s;
            }

                .stat-card:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 8px 25px rgba(0,0,0,.05);
                }

            .stat-icon {
                width: 43px;
                height: 43px;
                border-radius: 11px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 17px;
                margin-bottom: 18px;
            }

            .red {
                background: #ffe8e7;
                color: #e53935;
            }

            .blue {
                background: #e7f0ff;
                color: #3975d7;
            }

            .green {
                background: #e4f8ef;
                color: #21a56b;
            }

            .orange {
                background: #fff1df;
                color: #e99a2c;
            }

            .stat-label {
                color: #8992a1;
                font-size: 12px;
                margin-bottom: 8px;
            }

            .stat-number {
                font-size: 27px;
                font-weight: 800;
            }

            .content-card {
                background: white;
                border: 1px solid #edf0f4;
                border-radius: 13px;
                padding: 23px;
                margin-bottom: 25px;
            }

            .search-input,
            .filter-select {
                height: 44px;
                border: 1px solid #e5e9f0;
                border-radius: 8px;
                font-size: 12px;
                font-family: 'Inter', sans-serif;
            }

                .search-input:focus,
                .filter-select:focus {
                    border-color: #e53935;
                    box-shadow: 0 0 0 3px rgba(229,57,53,.1);
                }

            .table {
                margin-bottom: 0;
            }

                .table thead th {
                    background: #f8f9fc;
                    color: #8992a1;
                    font-size: 11px;
                    font-weight: 700;
                    padding: 15px 13px;
                    white-space: nowrap;
                    border-bottom: 1px solid #edf0f4;
                }

                .table tbody td {
                    font-size: 12px;
                    padding: 16px 13px;
                    vertical-align: middle;
                    border-bottom: 1px solid #f0f2f5;
                }

                .table tbody tr:last-child td {
                    border-bottom: none;
                }

            .account-name {
                font-weight: 700;
                color: #303846;
            }

            .account-id {
                color: #929aaa;
                font-size: 11px;
            }

            .role-badge {
                display: inline-block;
                padding: 7px 10px;
                border-radius: 20px;
                font-size: 10px;
                font-weight: 700;
                background: #e7f0ff;
                color: #3975d7;
                white-space: nowrap;
            }

            .role-owner {
                background: #fff1df;
                color: #d88920;
            }

            .status-badge {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 7px 10px;
                border-radius: 20px;
                font-size: 10px;
                font-weight: 700;
                white-space: nowrap;
            }

            .status-active {
                background: #e4f8ef;
                color: #21a56b;
            }

            .status-locked {
                background: #ffe8e7;
                color: #e53935;
            }

            
            .action-btn {
                width: 32px;
                height: 32px;
                border: 1px solid #e5e9f0;
                background: white;
                color: #64748b;
                border-radius: 8px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                transition: .2s;
            }

                .action-btn:hover,
                .action-btn[aria-expanded="true"] {
                    background: #ffe8e7;
                    color: #e53935;
                    border-color: #ffc9c6;
                }

            .dropdown-menu {
                border: 1px solid #edf0f4;
                border-radius: 10px;
                padding: 7px;
                min-width: 190px;
                box-shadow: 0 8px 25px rgba(0,0,0,.10);
            }

            .dropdown-item {
                font-size: 12px;
                padding: 10px 12px;
                border-radius: 6px;
            }

                .dropdown-item i {
                    width: 18px;
                }

                .dropdown-item:hover {
                    background: #f5f6fa;
                }

            .empty-state {
                text-align: center;
                padding: 45px 15px !important;
                color: #929aaa;
            }

                .empty-state i {
                    font-size: 35px;
                    color: #cbd2dc;
                    margin-bottom: 12px;
                }

            .table-footer {
                color: #929aaa;
                font-size: 11px;
                padding-top: 18px;
            }

            .sidebar-bottom {
                position: absolute;
                bottom: 20px;
                left: 18px;
                right: 18px;
                border-top: 1px solid #354253;
                padding-top: 15px;
            }

            .logout-btn {
                width: 100%;
                border: 0;
                background: transparent;
                color: #ffaaaa;
                text-align: left;
                padding: 10px 14px;
                font-size: 13px;
            }

                .logout-btn:hover {
                    color: white;
                }

            @@media (max-width: 900px) {
                .sidebar {
                    width: 75px;
                    padding: 20px 10px;
                }

                .brand {
                    justify-content: center;
                    padding: 5px 0 30px;
                }

                .brand-text,
                .menu-title,
                .menu-item span {
                    display: none;
                }

                .menu-item {
                    justify-content: center;
                    padding: 14px 5px;
                }

                .main {
                    margin-left: 75px;
                    padding: 25px 20px;
                }

                .sidebar-bottom {
                    left: 8px;
                    right: 8px;
                }

                .logout-btn {
                    text-align: center;
                }
            }

            @@media (max-width: 600px) {
                .main {
                    padding: 20px 13px;
                }

                .topbar h2 {
                    font-size: 18px;
                }

                .admin-info .admin-text {
                    display: none;
                }

                .welcome {
                    padding: 22px;
                }

                .content-card {
                    padding: 16px;
                }
            }
    </style>
</head>

<body>


    <aside class="sidebar">

        <div class="brand">
            <div class="brand-icon">
                <i class="fa-solid fa-plus"></i>
            </div>

            <div class="brand-text">
                <h4>NHA TRANG</h4>
                <small>RESCUE SYSTEM</small>
            </div>
        </div>

        <div class="menu-title">QUẢN LÝ CHUNG</div>

        <a href="/Admin/Index" class="menu-item">
            <i class="fa-solid fa-chart-pie"></i>
            <span>Tổng quan</span>
        </a>

        <div class="menu-title">QUẢN LÝ HỆ THỐNG</div>

        <a href="/QuanLyTaiKhoan/Index" class="menu-item active">
            <i class="fa-solid fa-users"></i>
            <span>Tài khoản</span>
        </a>

        <a href="#" class="menu-item">
            <i class="fa-solid fa-user-group"></i>
            <span>Khách hàng</span>
        </a>

        <a href="#" class="menu-item">
            <i class="fa-solid fa-shop"></i>
            <span>Cửa hàng sửa chữa</span>
        </a>

        <a href="#" class="menu-item">
            <i class="fa-solid fa-user-tie"></i>
            <span>Nhân viên</span>
        </a>

        <a href="#" class="menu-item">
            <i class="fa-solid fa-car"></i>
            <span>Phương tiện</span>
        </a>

        <a href="#" class="menu-item">
            <i class="fa-solid fa-screwdriver-wrench"></i>
            <span>Dịch vụ</span>
        </a>

        <div class="menu-title">CỨU HỘ VÀ VẬN HÀNH</div>

        <a href="#" class="menu-item">
            <i class="fa-solid fa-truck-fast"></i>
            <span>Yêu cầu cứu hộ</span>
        </a>

        <a href="#" class="menu-item">
            <i class="fa-solid fa-file-invoice-dollar"></i>
            <span>Thanh toán</span>
        </a>

        <div class="sidebar-bottom">
            <form asp-controller="TaiKhoan" asp-action="DangXuat" method="post">
                @Html.AntiForgeryToken()

                <button type="submit" class="logout-btn">
                    <i class="fa-solid fa-right-from-bracket me-2"></i>
                    <span>Đăng xuất</span>
                </button>
            </form>
        </div>

    </aside>

  
    <main class="main">

        <div class="topbar">
            <div>
                <h2>Quản lý tài khoản</h2>
                <p>Quản lý tài khoản khách hàng và chủ cửa hàng trong hệ thống.</p>
            </div>

            <div class="admin-info">
                <div class="avatar">
                    <i class="fa-solid fa-user-shield"></i>
                </div>

                <div class="admin-text">
                    <strong>@User.Identity?.Name</strong>
                    <small>Quản trị viên</small>
                </div>
            </div>
        </div>

        <section class="welcome">
            <h3>Quản lý tài khoản hệ thống</h3>
            <p>
                Theo dõi thông tin, vai trò và trạng thái hoạt động của người dùng NHA TRANG RESCUE.
            </p>
        </section>

   
        <h5 class="section-heading">Thống kê tài khoản</h5>

        <div class="row g-3 mb-4">

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-icon red">
                        <i class="fa-solid fa-users"></i>
                    </div>
                    <div class="stat-label">Tổng tài khoản</div>
                    <div class="stat-number">@tongTaiKhoan</div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-icon blue">
                        <i class="fa-solid fa-user-group"></i>
                    </div>
                    <div class="stat-label">Khách hàng</div>
                    <div class="stat-number">@soKhachHang</div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-icon orange">
                        <i class="fa-solid fa-shop"></i>
                    </div>
                    <div class="stat-label">Chủ cửa hàng</div>
                    <div class="stat-number">@soChuCuaHang</div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-icon green">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                    <div class="stat-label">Đang hoạt động</div>
                    <div class="stat-number">@dangHoatDong</div>
                </div>
            </div>

        </div>


        <div class="content-card">

            <h5 class="section-heading">
                <i class="fa-solid fa-list me-2" style="color:#e53935"></i>
                Danh sách tài khoản
            </h5>

           
            <form method="get"
                  asp-controller="QuanLyTaiKhoan"
                  asp-action="Index"
                  id="searchForm">

                <div class="row g-2 mb-4">

                    <div class="col-md-8">
                        <input type="text"
                               name="tuKhoa"
                               id="tuKhoa"
                               value="@ViewBag.TuKhoa"
                               placeholder="Tìm tài khoản..."
                               class="form-control search-input">
                    </div>

                    <div class="col-md-4">
                        <select name="vaiTro"
                                id="vaiTro"
                                class="form-select filter-select">

                            <option value="">Tất cả vai trò</option>

                            <option value="KhachHang"
                                    selected="@(ViewBag.VaiTro?.ToString() == "KhachHang")">
                                Khách hàng
                            </option>

                            <option value="ChuCuaHang"
                                    selected="@(ViewBag.VaiTro?.ToString() == "ChuCuaHang")">
                                Chủ cửa hàng
                            </option>

                        </select>
                    </div>

                </div>
            </form>

           
            <div class="table-responsive">

                <table class="table table-hover">

                    <thead>
                        <tr>
                            <th>MÃ TÀI KHOẢN</th>
                            <th>TÊN ĐĂNG NHẬP</th>
                            <th>THÔNG TIN NGƯỜI DÙNG</th>
                            <th>VAI TRÒ</th>
                            <th>TRẠNG THÁI / THAO TÁC</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        <span class="account-id">
                                            #@item.MaTK
                                        </span>
                                    </td>

                                    <td>
                                        <span class="account-name">
                                            @item.TenDangNhap
                                        </span>
                                    </td>

                                    <td>
                                        @if (item.VaiTro == "KhachHang")
                                        {
                                            <div class="fw-semibold">
                                                @(item.HoTen ?? "Chưa cập nhật")
                                            </div>

                                            <small class="text-secondary">
                                                <i class="fa-solid fa-phone me-1"></i>
                                                @(item.SoDienThoai ?? "Chưa có số điện thoại")
                                            </small>
                                        }
                                        else
                                        {
                                            <div class="fw-semibold">
                                                @(item.TenCuaHang ?? "Chưa liên kết cửa hàng")
                                            </div>

                                            <small class="text-secondary">
                                                Chủ cửa hàng
                                            </small>
                                        }
                                    </td>

                                    <td>
                                        @if (item.VaiTro == "KhachHang")
                                        {
                                            <span class="role-badge">
                                                <i class="fa-solid fa-user me-1"></i>
                                                Khách hàng
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="role-badge role-owner">
                                                <i class="fa-solid fa-shop me-1"></i>
                                                Chủ cửa hàng
                                            </span>
                                        }
                                    </td>

                                    
                                    <td>

                                        <div class="d-flex align-items-center gap-2">

                                            @if (item.TrangThai)
                                            {
                                                <span class="status-badge status-active">
                                                    <i class="fa-solid fa-circle-check"></i>
                                                    Hoạt động
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-locked">
                                                    <i class="fa-solid fa-lock"></i>
                                                    Đã khóa
                                                </span>
                                            }

                                      
                                            <div class="dropdown">

                                                <button class="action-btn"
                                                        type="button"
                                                        data-bs-toggle="dropdown"
                                                        aria-expanded="false"
                                                        title="Thao tác tài khoản">

                                                    <i class="fa-solid fa-pen"></i>

                                                </button>

                                                <ul class="dropdown-menu dropdown-menu-end">

                                                    <li>
                                                        <a class="dropdown-item"
                                                           href="/QuanLyTaiKhoan/Details/@item.MaTK">

                                                            <i class="fa-solid fa-eye me-2 text-secondary"></i>
                                                            Xem chi tiết

                                                        </a>
                                                    </li>

                                                    <li>
                                                        <a class="dropdown-item"
                                                           href="/QuanLyTaiKhoan/Edit/@item.MaTK">

                                                            <i class="fa-solid fa-pen-to-square me-2 text-primary"></i>
                                                            Chỉnh sửa

                                                        </a>
                                                    </li>

                                                    <li>
                                                        <a class="dropdown-item"
                                                           href="/QuanLyTaiKhoan/ToggleStatus/@item.MaTK">

                                                            @if (item.TrangThai)
                                                            {
                                                                <i class="fa-solid fa-lock me-2 text-warning"></i>
                                                                <span>Khóa tài khoản</span>
                                                            }
                                                            else
                                                            {
                                                                <i class="fa-solid fa-lock-open me-2 text-success"></i>
                                                                <span>Mở khóa tài khoản</span>
                                                            }

                                                        </a>
                                                    </li>

                                                    <li>
                                                        <hr class="dropdown-divider">
                                                    </li>

                                                    <li>
                                                        <a class="dropdown-item text-danger"
                                                           href="/QuanLyTaiKhoan/Delete/@item.MaTK">

                                                            <i class="fa-solid fa-trash me-2"></i>
                                                            Xóa tài khoản

                                                        </a>
                                                    </li>

                                                </ul>

                                            </div>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="empty-state">
                                    <i class="fa-solid fa-folder-open d-block"></i>
                                    Không tìm thấy tài khoản phù hợp.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="table-footer">
                Hiển thị @Model.Count tài khoản
                <span class="mx-2">|</span>
                Đã khóa: @daKhoa tài khoản
            </div>

        </div>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
            const form = document.getElementById("searchForm");
            const input = document.getElementById("tuKhoa");
            const select = document.getElementById("vaiTro");

            let timer;

      
            input.addEventListener("input", function () {
                clearTimeout(timer);

                timer = setTimeout(function () {
                    form.submit();
                }, 400);
            });

          
            select.addEventListener("change", function () {
                form.submit();
            });
    </script>

</body>
</html>
