@model HeThongCuuHo.Models.DangKyViewModel

@{
    ViewData["Title"] = "Đăng ký - Nha Trang Rescue";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                font-family: 'Inter', sans-serif;
                background: #f4f6fa;
            }

            .login-container {
                display: flex;
                min-height: 100vh;
                padding: 24px;
                gap: 24px;
            }

            .left-panel {
                position: relative;
                width: 55%;
                min-height: calc(100vh - 48px);
                overflow: hidden;
                border-radius: 20px;
                background: #182638;
            }

                .left-panel img {
                    position: absolute;
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    inset: 0;
                    filter: blur(3px);
                    transform: scale(1.03);
                    z-index: 0;
                }

            .image-overlay {
                position: absolute;
                inset: 0;
                background: linear-gradient( 180deg, rgba(8, 20, 35, 0.25), rgba(8, 20, 35, 0.88) );
                z-index: 1;
            }

            .brand {
                position: absolute;
                top: 38px;
                left: 42px;
                display: flex;
                align-items: center;
                gap: 12px;
                color: white;
                font-size: 19px;
                font-weight: 800;
                letter-spacing: 0.5px;
                z-index: 2;
            }

            .brand-icon {
                width: 44px;
                height: 44px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 12px;
                background: #e53935;
                font-size: 23px;
            }

            .intro-content {
                position: absolute;
                left: 55px;
                right: 55px;
                bottom: 75px;
                color: white;
                z-index: 2;
            }

            .intro-tag {
                display: inline-block;
                padding: 8px 14px;
                margin-bottom: 22px;
                border: 1px solid rgba(255,255,255,0.35);
                border-radius: 30px;
                background: rgba(255,255,255,0.12);
                font-size: 12px;
                font-weight: 600;
                letter-spacing: 1px;
            }

            .intro-content h1 {
                max-width: 600px;
                font-size: clamp(30px, 3.5vw, 48px);
                line-height: 1.2;
                font-weight: 800;
                margin-bottom: 20px;
            }

            .intro-content p {
                max-width: 500px;
                color: #d5dce5;
                font-size: 15px;
                line-height: 1.8;
            }

            .right-panel {
                flex: 1;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 20px 35px;
            }

            .register-form {
                width: 100%;
                max-width: 420px;
            }

            .form-heading {
                margin-bottom: 20px;
            }

                .form-heading .small-title {
                    color: #e53935;
                    font-size: 13px;
                    font-weight: 700;
                    letter-spacing: 1.5px;
                    text-transform: uppercase;
                    margin-bottom: 8px;
                }

                .form-heading h2 {
                    color: #172334;
                    font-size: 32px;
                    font-weight: 800;
                    margin-bottom: 8px;
                }

                .form-heading p {
                    color: #7b8492;
                    font-size: 14px;
                    line-height: 1.6;
                    margin-bottom: 0;
                }

            .form-label {
                color: #344054;
                font-size: 13px;
                font-weight: 600;
                margin-bottom: 6px;
            }

            .form-control {
                height: 44px;
                padding: 10px 15px;
                border: 1px solid #dce1e8;
                border-radius: 9px;
                font-size: 13px;
                box-shadow: none;
            }

                .form-control:focus {
                    border-color: #e53935;
                    box-shadow: 0 0 0 3px rgba(229, 57, 53, 0.1);
                }

            .mb-field {
                margin-bottom: 11px;
            }

            .btn-register {
                width: 100%;
                height: 50px;
                margin-top: 5px;
                border: none;
                border-radius: 9px;
                background: #e53935;
                color: white;
                font-size: 14px;
                font-weight: 700;
                transition: 0.2s;
            }

                .btn-register:hover {
                    background: #c62828;
                    transform: translateY(-1px);
                    box-shadow: 0 6px 15px rgba(229, 57, 53, 0.2);
                }

            .text-danger {
                display: block;
                font-size: 11px;
                margin-top: 3px;
            }

            .bottom-text {
                margin-top: 17px;
                color: #7b8492;
                text-align: center;
                font-size: 13px;
            }

                .bottom-text a {
                    color: #e53935;
                    font-weight: 700;
                    text-decoration: none;
                    margin-left: 4px;
                }

                    .bottom-text a:hover {
                        color: #c62828;
                        text-decoration: underline;
                    }

            .footer {
                margin-top: 20px;
                color: #98a1ad;
                text-align: center;
                font-size: 11px;
            }

            .alert {
                font-size: 13px;
                border-radius: 9px;
            }

            @@media (max-width: 900px) {
                .login-container {
                    padding: 15px;
                }

                .left-panel {
                    width: 45%;
                }

                .intro-content {
                    left: 30px;
                    right: 30px;
                    bottom: 45px;
                }

                .brand {
                    left: 30px;
                    top: 25px;
                }

                .right-panel {
                    padding: 20px;
                }
            }

            @@media (max-width: 650px) {
                .login-container {
                    padding: 0;
                }

                .left-panel {
                    display: none;
                }

                .right-panel {
                    min-height: 100vh;
                    padding: 30px 24px;
                }

                .form-heading h2 {
                    font-size: 28px;
                }
            }
    </style>
</head>

<body>

    <div class="login-container">

        <div class="left-panel">

            <img src="/img/paintless-dent-repair%20(1).jpeg"
                 alt="Dịch vụ sửa chữa xe" />

            <div class="image-overlay"></div>

            <div class="brand">
                <div class="brand-icon">✚</div>
                <span>NHA TRANG RESCUE</span>
            </div>

            <div class="intro-content">

                <div class="intro-tag">
                    HỖ TRỢ CỨU HỘ 24/7
                </div>

                <h1>Đồng hành cùng bạn trên mọi hành trình.</h1>

                <p>
                    Nha Trang Rescue là hệ thống quản lý cứu hộ và sửa chữa xe thông minh,
                    kết nối khách hàng với các cửa hàng sửa chữa và đội ngũ cứu hộ
                    nhanh chóng, thuận tiện và hiệu quả.
                </p>

            </div>

        </div>

        <div class="right-panel">

            <div class="register-form">

                <div class="form-heading">
                    <div class="small-title">Tham gia cùng chúng tôi</div>

                    <h2>Tạo tài khoản</h2>

                    <p>
                        Điền thông tin bên dưới để đăng ký tài khoản
                        Nha Trang Rescue.
                    </p>
                </div>

                <form asp-controller="TaiKhoan"
                      asp-action="DangKy"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"></div>

                    <div class="mb-field">
                        <label class="form-label">Họ và tên</label>

                        <input asp-for="HoTen"
                               class="form-control"
                               placeholder="Nhập họ và tên" />

                        <span asp-validation-for="HoTen"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-field">
                        <label class="form-label">Số điện thoại</label>

                        <input asp-for="SoDienThoai"
                               class="form-control"
                               placeholder="Nhập số điện thoại" />

                        <span asp-validation-for="SoDienThoai"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-field">
                        <label class="form-label">Email</label>

                        <input asp-for="Email"
                               class="form-control"
                               placeholder="example@gmail.com" />

                        <span asp-validation-for="Email"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-field">
                        <label class="form-label">Tên đăng nhập</label>

                        <input asp-for="TenDangNhap"
                               class="form-control"
                               placeholder="Tạo tên đăng nhập"
                               autocomplete="username" />

                        <span asp-validation-for="TenDangNhap"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-field">
                        <label class="form-label">Mật khẩu</label>

                        <input asp-for="MatKhau"
                               type="password"
                               class="form-control"
                               placeholder="Ít nhất 6 ký tự"
                               autocomplete="new-password" />

                        <span asp-validation-for="MatKhau"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-field">
                        <label class="form-label">Xác nhận mật khẩu</label>

                        <input asp-for="XacNhanMatKhau"
                               type="password"
                               class="form-control"
                               placeholder="Nhập lại mật khẩu"
                               autocomplete="new-password" />

                        <span asp-validation-for="XacNhanMatKhau"
                              class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn-register">
                        TẠO TÀI KHOẢN
                    </button>

                </form>

                <div class="bottom-text">
                    Đã có tài khoản?

                    <a asp-controller="TaiKhoan"
                       asp-action="DangNhap">
                        Đăng nhập
                    </a>
                </div>

                <div class="footer">
                    © 2026 Nha Trang Rescue. All rights reserved.
                </div>

            </div>

        </div>

    </div>

</body>
</html>
