@model HeThongCuuHo.Models.DangKyViewModel

@{
    ViewData["Title"] = "Đăng ký - Nha Trang Rescue";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>NHA TRANG RESCUE | Đăng ký</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                background: #f5f6fa;
                color: #252b36;
                font-family: 'Inter', sans-serif;
                font-size: 13px;
            }

            .register-container {
                display: flex;
                min-height: 100vh;
                padding: 24px;
                gap: 24px;
            }

            .left-panel {
                position: relative;
                width: 55%;
                min-height: calc(100vh - 48px);
                overflow: hidden;
                border-radius: 16px;
                background: #182638;
                flex-shrink: 0;
            }

                .left-panel img {
                    position: absolute;
                    inset: 0;
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    filter: blur(2px);
                    transform: scale(1.03);
                }

            .image-overlay {
                position: absolute;
                inset: 0;
                background: linear-gradient(180deg, rgba(24, 38, 56, .45), rgba(24, 38, 56, .95));
            }

            .brand {
                position: absolute;
                top: 32px;
                left: 35px;
                display: flex;
                align-items: center;
                gap: 11px;
                color: white;
                z-index: 2;
            }

            .brand-icon {
                width: 42px;
                height: 42px;
                background: #e53935;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 19px;
            }

            .brand-name {
                font-size: 15px;
                font-weight: 800;
                letter-spacing: .3px;
                line-height: 1.4;
            }

                .brand-name span {
                    display: block;
                    font-size: 9px;
                    color: #aab7c8;
                    letter-spacing: 1.5px;
                    font-weight: 600;
                }

            .intro-content {
                position: absolute;
                left: 45px;
                right: 45px;
                bottom: 65px;
                color: white;
                z-index: 2;
            }

            .intro-tag {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 8px 13px;
                margin-bottom: 20px;
                border-radius: 7px;
                background: rgba(255,255,255,.15);
                border: 1px solid rgba(255,255,255,.2);
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 1px;
            }

            .intro-content h1 {
                max-width: 550px;
                font-size: clamp(30px, 3.5vw, 45px);
                font-weight: 800;
                line-height: 1.25;
                margin-bottom: 17px;
            }

            .intro-content p {
                max-width: 480px;
                color: #c2ccda;
                font-size: 12px;
                line-height: 1.9;
                margin: 0;
            }

            .right-panel {
                flex: 1;
                min-width: 0;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 20px 30px;
            }

            .register-form {
                width: 100%;
                max-width: 400px;
            }

            .form-icon {
                width: 55px;
                height: 55px;
                border-radius: 13px;
                background: #fdebea;
                color: #e53935;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 22px;
                margin-bottom: 16px;
            }

            .form-heading {
                margin-bottom: 18px;
            }

            .small-title {
                color: #e53935;
                font-size: 10px;
                font-weight: 800;
                letter-spacing: 1.5px;
                margin-bottom: 8px;
            }

            .form-heading h2 {
                color: #252b36;
                font-size: 27px;
                font-weight: 800;
                margin-bottom: 8px;
            }

            .form-heading p {
                color: #929baa;
                font-size: 12px;
                line-height: 1.7;
                margin: 0;
            }

            .form-label {
                color: #344054;
                font-size: 11px;
                font-weight: 700;
                margin-bottom: 6px;
            }

            .input-wrapper {
                position: relative;
            }

                .input-wrapper i {
                    position: absolute;
                    left: 15px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: #929baa;
                    font-size: 13px;
                    pointer-events: none;
                }

            .form-control {
                height: 43px;
                padding: 10px 15px 10px 42px;
                border: 1px solid #edf0f4;
                border-radius: 9px;
                background: white;
                font-size: 12px;
                box-shadow: 0 3px 12px rgba(0,0,0,.025);
            }

                .form-control:focus {
                    border-color: #e53935;
                    box-shadow: 0 0 0 3px rgba(229,57,53,.1);
                }

            .mb-field {
                margin-bottom: 10px;
            }

            .text-danger {
                display: block;
                font-size: 10px;
                margin-top: 3px;
            }

            .validation-summary-errors {
                margin-bottom: 12px;
                padding: 10px 14px;
                border: 1px solid #f5c2c7;
                border-radius: 9px;
                background: #f8d7da;
                color: #842029;
                font-size: 11px;
            }

                .validation-summary-errors ul {
                    margin: 0;
                    padding-left: 18px;
                }

            .btn-register {
                width: 100%;
                height: 49px;
                margin-top: 7px;
                border: none;
                border-radius: 9px;
                background: #e53935;
                color: white;
                font-size: 12px;
                font-weight: 800;
                letter-spacing: .5px;
                transition: .2s;
            }

                .btn-register:hover {
                    background: #c62828;
                    transform: translateY(-2px);
                    box-shadow: 0 6px 18px rgba(229,57,53,.2);
                }

            .bottom-text {
                margin-top: 17px;
                color: #929baa;
                text-align: center;
                font-size: 11px;
            }

                .bottom-text a {
                    color: #e53935;
                    font-weight: 800;
                    text-decoration: none;
                    margin-left: 4px;
                }

                    .bottom-text a:hover {
                        color: #c62828;
                        text-decoration: underline;
                    }

            .footer {
                margin-top: 22px;
                color: #a0a8b4;
                text-align: center;
                font-size: 10px;
            }

            @@media (max-width: 900px) {
                .register-container {
                    padding: 15px;
                    gap: 15px;
                }

                .left-panel {
                    width: 45%;
                }

                .brand {
                    left: 25px;
                }

                .intro-content {
                    left: 25px;
                    right: 25px;
                    bottom: 40px;
                }

                .right-panel {
                    padding: 20px;
                }
            }

            @@media (max-width: 650px) {
                .register-container {
                    padding: 0;
                }

                .left-panel {
                    display: none;
                }

                .right-panel {
                    min-height: 100vh;
                    padding: 30px 24px;
                }

                .register-form {
                    max-width: 450px;
                }

                .form-heading h2 {
                    font-size: 25px;
                }
            }
    </style>
</head>

<body>

    <div class="register-container">

        <div class="left-panel">

            <img src="/img/paintless-dent-repair%20(1).jpeg"
                 alt="Dịch vụ sửa chữa xe" />

            <div class="image-overlay"></div>

            <div class="brand">

                <div class="brand-icon">
                    <i class="fa-solid fa-truck-fast"></i>
                </div>

                <div class="brand-name">
                    NHA TRANG RESCUE
                    <span>GARAGE MANAGEMENT</span>
                </div>

            </div>

            <div class="intro-content">

                <div class="intro-tag">
                    <i class="fa-solid fa-clock"></i>
                    HỖ TRỢ CỨU HỘ 24/7
                </div>

                <h1>Đồng hành cùng bạn trên mọi hành trình.</h1>

                <p>
                    Nha Trang Rescue là hệ thống quản lý cứu hộ và sửa chữa xe thông minh,
                    kết nối khách hàng với các cửa hàng sửa chữa và đội ngũ cứu hộ
                    nhanh chóng, thuận tiện và hiệu quả.
                </p>

            </div>

        </div>

        <div class="right-panel">

            <div class="register-form">

                <div class="form-icon">
                    <i class="fa-solid fa-user-plus"></i>
                </div>

                <div class="form-heading">

                    <div class="small-title">THAM GIA CÙNG CHÚNG TÔI</div>

                    <h2>Tạo tài khoản</h2>

                    <p>
                        Điền thông tin bên dưới để đăng ký tài khoản
                        Nha Trang Rescue.
                    </p>

                </div>

                <form asp-controller="TaiKhoan"
                      asp-action="DangKy"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"></div>

                    <div class="mb-field">

                        <label class="form-label">Họ và tên</label>

                        <div class="input-wrapper">
                            <i class="fa-solid fa-user"></i>

                            <input asp-for="HoTen"
                                   class="form-control"
                                   placeholder="Nhập họ và tên" />
                        </div>

                        <span asp-validation-for="HoTen"
                              class="text-danger"></span>

                    </div>

                    <div class="mb-field">

                        <label class="form-label">Số điện thoại</label>

                        <div class="input-wrapper">
                            <i class="fa-solid fa-phone"></i>

                            <input asp-for="SoDienThoai"
                                   class="form-control"
                                   placeholder="Nhập số điện thoại" />
                        </div>

                        <span asp-validation-for="SoDienThoai"
                              class="text-danger"></span>

                    </div>

                    <div class="mb-field">

                        <label class="form-label">Email</label>

                        <div class="input-wrapper">
                            <i class="fa-solid fa-envelope"></i>

                            <input asp-for="Email"
                                   class="form-control"
                                   placeholder="example@gmail.com" />
                        </div>

                        <span asp-validation-for="Email"
                              class="text-danger"></span>

                    </div>

                    <div class="mb-field">

                        <label class="form-label">Tên đăng nhập</label>

                        <div class="input-wrapper">
                            <i class="fa-solid fa-id-card"></i>

                            <input asp-for="TenDangNhap"
                                   class="form-control"
                                   placeholder="Tạo tên đăng nhập"
                                   autocomplete="username" />
                        </div>

                        <span asp-validation-for="TenDangNhap"
                              class="text-danger"></span>

                    </div>

                    <div class="mb-field">

                        <label class="form-label">Mật khẩu</label>

                        <div class="input-wrapper">
                            <i class="fa-solid fa-lock"></i>

                            <input asp-for="MatKhau"
                                   type="password"
                                   class="form-control"
                                   placeholder="Ít nhất 6 ký tự"
                                   autocomplete="new-password" />
                        </div>

                        <span asp-validation-for="MatKhau"
                              class="text-danger"></span>

                    </div>

                    <div class="mb-field">

                        <label class="form-label">Xác nhận mật khẩu</label>

                        <div class="input-wrapper">
                            <i class="fa-solid fa-shield-halved"></i>

                            <input asp-for="XacNhanMatKhau"
                                   type="password"
                                   class="form-control"
                                   placeholder="Nhập lại mật khẩu"
                                   autocomplete="new-password" />
                        </div>

                        <span asp-validation-for="XacNhanMatKhau"
                              class="text-danger"></span>

                    </div>

                    <button type="submit" class="btn-register">
                        <i class="fa-solid fa-user-plus me-2"></i>
                        TẠO TÀI KHOẢN
                    </button>

                </form>

                <div class="bottom-text">
                    Đã có tài khoản?

                    <a asp-controller="TaiKhoan"
                       asp-action="DangNhap">
                        Đăng nhập
                    </a>
                </div>

                <div class="footer">
                    NHA TRANG RESCUE © 2026
                </div>

            </div>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>
