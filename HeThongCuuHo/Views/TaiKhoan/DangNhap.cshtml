@{
    ViewData["Title"] = "Đăng nhập - Nha Trang Rescue";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Nha Trang Rescue - Đăng nhập</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                font-family: 'Inter', sans-serif;
                background: #f4f6fa;
            }

            .login-container {
                display: flex;
                min-height: 100vh;
                padding: 24px;
                gap: 24px;
            }

            .left-panel {
                position: relative;
                width: 55%;
                min-height: calc(100vh - 48px);
                overflow: hidden;
                border-radius: 20px;
                background: #182638;
            }

                .left-panel img {
                    position: absolute;
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    inset: 0;
                    filter: blur(3px);
                    transform: scale(1.03);
                    z-index: 0;
                }

            .image-overlay {
                position: absolute;
                inset: 0;
                background: linear-gradient( 180deg, rgba(8, 20, 35, 0.25), rgba(8, 20, 35, 0.88) );
                z-index: 1;
            }

            .brand {
                position: absolute;
                top: 38px;
                left: 42px;
                display: flex;
                align-items: center;
                gap: 12px;
                color: white;
                font-size: 19px;
                font-weight: 800;
                letter-spacing: 0.5px;
                z-index: 2;
            }

            .brand-icon {
                width: 44px;
                height: 44px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 12px;
                background: #e53935;
                font-size: 23px;
            }

            .intro-content {
                position: absolute;
                left: 55px;
                right: 55px;
                bottom: 75px;
                color: white;
                z-index: 2;
            }

            .intro-tag {
                display: inline-block;
                padding: 8px 14px;
                margin-bottom: 22px;
                border: 1px solid rgba(255,255,255,0.35);
                border-radius: 30px;
                background: rgba(255,255,255,0.12);
                font-size: 12px;
                font-weight: 600;
                letter-spacing: 1px;
            }

            .intro-content h1 {
                max-width: 600px;
                font-size: clamp(30px, 3.5vw, 48px);
                line-height: 1.2;
                font-weight: 800;
                margin-bottom: 20px;
            }

            .intro-content p {
                max-width: 500px;
                color: #d5dce5;
                font-size: 15px;
                line-height: 1.8;
            }

            .right-panel {
                flex: 1;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 35px;
            }

            .login-form {
                width: 100%;
                max-width: 420px;
            }

            .form-heading {
                margin-bottom: 35px;
            }

                .form-heading .small-title {
                    color: #e53935;
                    font-size: 13px;
                    font-weight: 700;
                    letter-spacing: 1.5px;
                    text-transform: uppercase;
                    margin-bottom: 12px;
                }

                .form-heading h2 {
                    color: #172334;
                    font-size: 32px;
                    font-weight: 800;
                    margin-bottom: 12px;
                }

                .form-heading p {
                    color: #7b8492;
                    font-size: 14px;
                    line-height: 1.7;
                }

            .form-label {
                color: #344054;
                font-size: 13px;
                font-weight: 600;
                margin-bottom: 9px;
            }

            .form-control {
                height: 52px;
                padding: 12px 15px;
                border: 1px solid #dce1e8;
                border-radius: 9px;
                font-size: 14px;
                box-shadow: none;
            }

                .form-control:focus {
                    border-color: #e53935;
                    box-shadow: 0 0 0 3px rgba(229, 57, 53, 0.1);
                }

            .password-wrapper {
                position: relative;
            }

                .password-wrapper .form-control {
                    padding-right: 55px;
                }

            .toggle-password {
                position: absolute;
                top: 50%;
                right: 15px;
                transform: translateY(-50%);
                border: none;
                background: transparent;
                color: #7b8492;
                font-size: 12px;
                font-weight: 600;
            }

            .btn-login {
                width: 100%;
                height: 52px;
                margin-top: 12px;
                border: none;
                border-radius: 9px;
                background: #e53935;
                color: white;
                font-size: 14px;
                font-weight: 700;
                transition: 0.2s;
            }

                .btn-login:hover {
                    background: #c62828;
                    transform: translateY(-1px);
                    box-shadow: 0 6px 15px rgba(229, 57, 53, 0.2);
                }

            .login-footer {
                margin-top: 35px;
                color: #98a1ad;
                text-align: center;
                font-size: 12px;
            }

            .alert {
                font-size: 13px;
                border-radius: 9px;
            }

            @@media (max-width: 900px) {
                .login-container {
                    padding: 15px;
                }

                .left-panel {
                    width: 45%;
                }

                .intro-content {
                    left: 30px;
                    right: 30px;
                    bottom: 45px;
                }

                .brand {
                    left: 30px;
                    top: 25px;
                }

                .right-panel {
                    padding: 20px;
                }
            }

            @@media (max-width: 650px) {
                .login-container {
                    padding: 0;
                }

                .left-panel {
                    display: none;
                }

                .right-panel {
                    min-height: 100vh;
                    padding: 30px 24px;
                }

                .form-heading h2 {
                    font-size: 28px;
                }

                .register-link {
                    margin-top: 22px;
                    text-align: center;
                    font-size: 13px;
                    color: #7b8492;
                }

                    .register-link a {
                        color: #e53935;
                        font-weight: 700;
                        text-decoration: none;
                        margin-left: 4px;
                    }

                        .register-link a:hover {
                            color: #c62828;
                            text-decoration: underline;
                        }
            }
    </style>
</head>

<body>
    <div class="login-container">

        <div class="left-panel">
            <img src="/img/paintless-dent-repair%20(1).jpeg"
                 alt="Dịch vụ sửa chữa xe" />

            <div class="image-overlay"></div>

            <div class="brand">
                <div class="brand-icon">✚</div>
                <span>NHA TRANG RESCUE</span>
            </div>

            <div class="intro-content">
                <div class="intro-tag">HỖ TRỢ CỨU HỘ 24/7</div>

                <h1>Đồng hành cùng bạn trên mọi hành trình.</h1>

                <p>
                    Nha Trang Rescue là hệ thống quản lý cứu hộ và sửa chữa xe thông minh,
                    kết nối khách hàng với các cửa hàng sửa chữa và đội ngũ cứu hộ
                    nhanh chóng, thuận tiện và hiệu quả.
                </p>
            </div>
        </div>

        <div class="right-panel">
            <div class="login-form">

                <div class="form-heading">
                    <div class="small-title">Chào mừng trở lại</div>
                    <h2>Đăng nhập</h2>
                    <p>
                        Vui lòng nhập thông tin tài khoản để truy cập
                        hệ thống Nha Trang Rescue.
                    </p>
                </div>

                @if (ViewBag.Loi != null)
                {
                    <div class="alert alert-danger">
                        @ViewBag.Loi
                    </div>
                }

                <form action="/TaiKhoan/DangNhap" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <label class="form-label">Tên đăng nhập</label>
                        <input type="text"
                               name="tenDangNhap"
                               class="form-control"
                               placeholder="Nhập tên đăng nhập"
                               autocomplete="username"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mật khẩu</label>

                        <div class="password-wrapper">
                            <input type="password"
                                   id="matKhau"
                                   name="matKhau"
                                   class="form-control"
                                   placeholder="Nhập mật khẩu"
                                   autocomplete="current-password"
                                   required />

                            <button type="button"
                                    class="toggle-password"
                                    onclick="togglePassword()">
                                HIỆN
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn-login">
                        ĐĂNG NHẬP
                    </button>

                    <div class="register-link">
                        <span>Chưa có tài khoản?</span>
                        <a href="/TaiKhoan/DangKy">Đăng ký ngay</a>
                    </div>

                </form>

                <div class="login-footer">
                    © 2026 Nha Trang Rescue. All rights reserved.
                </div>

            </div>
        </div>

    </div>

    <script>
            function togglePassword() {
                const input = document.getElementById("matKhau");
                const button = document.querySelector(".toggle-password");

                if (input.type === "password") {
                    input.type = "text";
                    button.textContent = "ẨN";
                } else {
                    input.type = "password";
                    button.textContent = "HIỆN";
                }
            }
    </script>
</body>
</html>
