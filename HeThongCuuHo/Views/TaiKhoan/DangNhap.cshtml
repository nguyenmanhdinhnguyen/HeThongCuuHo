@{
    ViewData["Title"] = "Đăng nhập - Nha Trang Rescue";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>NHA TRANG RESCUE | Đăng nhập</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                background: #f5f6fa;
                color: #252b36;
                font-family: 'Inter', sans-serif;
                font-size: 13px;
            }

            .login-container {
                display: flex;
                min-height: 100vh;
                padding: 24px;
                gap: 24px;
            }

            /* LEFT PANEL */
            .left-panel {
                position: relative;
                width: 55%;
                min-height: calc(100vh - 48px);
                overflow: hidden;
                border-radius: 16px;
                background: #182638;
            }

                .left-panel img {
                    position: absolute;
                    inset: 0;
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    filter: blur(2px);
                    transform: scale(1.03);
                }

            .image-overlay {
                position: absolute;
                inset: 0;
                background: linear-gradient( 180deg, rgba(24, 38, 56, .45), rgba(24, 38, 56, .95) );
            }

            .brand {
                position: absolute;
                top: 32px;
                left: 35px;
                display: flex;
                align-items: center;
                gap: 11px;
                color: white;
                z-index: 2;
            }

            .brand-icon {
                width: 42px;
                height: 42px;
                background: #e53935;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 19px;
            }

            .brand-name {
                font-size: 15px;
                font-weight: 800;
                letter-spacing: .3px;
                line-height: 1.4;
            }

                .brand-name span {
                    display: block;
                    font-size: 9px;
                    color: #aab7c8;
                    letter-spacing: 1.5px;
                    font-weight: 600;
                }

            .intro-content {
                position: absolute;
                left: 45px;
                right: 45px;
                bottom: 65px;
                color: white;
                z-index: 2;
            }

            .intro-tag {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 8px 13px;
                margin-bottom: 20px;
                border-radius: 7px;
                background: rgba(255,255,255,.15);
                border: 1px solid rgba(255,255,255,.2);
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 1px;
            }

            .intro-content h1 {
                max-width: 550px;
                font-size: clamp(30px, 3.5vw, 45px);
                font-weight: 800;
                line-height: 1.25;
                margin-bottom: 17px;
            }

            .intro-content p {
                max-width: 480px;
                color: #c2ccda;
                font-size: 12px;
                line-height: 1.9;
                margin: 0;
            }

            /* RIGHT PANEL */
            .right-panel {
                flex: 1;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 30px;
            }

            .login-form {
                width: 100%;
                max-width: 400px;
            }

            .form-icon {
                width: 55px;
                height: 55px;
                border-radius: 13px;
                background: #fdebea;
                color: #e53935;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 22px;
                margin-bottom: 23px;
            }

            .form-heading {
                margin-bottom: 30px;
            }

            .small-title {
                color: #e53935;
                font-size: 10px;
                font-weight: 800;
                letter-spacing: 1.5px;
                margin-bottom: 10px;
            }

            .form-heading h2 {
                color: #252b36;
                font-size: 27px;
                font-weight: 800;
                margin-bottom: 10px;
            }

            .form-heading p {
                color: #929baa;
                font-size: 12px;
                line-height: 1.8;
                margin: 0;
            }

            .form-label {
                color: #344054;
                font-size: 11px;
                font-weight: 700;
                margin-bottom: 9px;
            }

            .input-wrapper {
                position: relative;
            }

                .input-wrapper i {
                    position: absolute;
                    left: 15px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: #929baa;
                    font-size: 13px;
                }

            .form-control {
                height: 49px;
                padding: 12px 15px 12px 42px;
                border: 1px solid #edf0f4;
                border-radius: 9px;
                background: white;
                font-size: 12px;
                box-shadow: 0 3px 12px rgba(0,0,0,.025);
            }

                .form-control:focus {
                    border-color: #e53935;
                    box-shadow: 0 0 0 3px rgba(229,57,53,.1);
                }

            .password-wrapper .form-control {
                padding-right: 65px;
            }

            .toggle-password {
                position: absolute;
                top: 50%;
                right: 14px;
                transform: translateY(-50%);
                border: none;
                background: transparent;
                color: #929baa;
                font-size: 10px;
                font-weight: 700;
                cursor: pointer;
            }

                .toggle-password:hover {
                    color: #e53935;
                }

            .btn-login {
                width: 100%;
                height: 49px;
                margin-top: 12px;
                border: none;
                border-radius: 9px;
                background: #e53935;
                color: white;
                font-size: 12px;
                font-weight: 800;
                letter-spacing: .5px;
                transition: .2s;
            }

                .btn-login:hover {
                    background: #c62828;
                    transform: translateY(-2px);
                    box-shadow: 0 6px 18px rgba(229,57,53,.2);
                }

            .register-link {
                margin-top: 22px;
                text-align: center;
                color: #929baa;
                font-size: 11px;
            }

                .register-link a {
                    color: #e53935;
                    font-weight: 800;
                    text-decoration: none;
                    margin-left: 4px;
                }

                    .register-link a:hover {
                        color: #c62828;
                        text-decoration: underline;
                    }

            .alert {
                border-radius: 9px;
                font-size: 12px;
                padding: 12px 14px;
            }

            .login-footer {
                margin-top: 45px;
                color: #a0a8b4;
                text-align: center;
                font-size: 10px;
            }

            /* RESPONSIVE */
            @@media (max-width: 900px) {
                .login-container {
                    padding: 15px;
                    gap: 15px;
                }

                .left-panel {
                    width: 45%;
                }

                .brand {
                    left: 25px;
                }

                .intro-content {
                    left: 25px;
                    right: 25px;
                    bottom: 40px;
                }

                .right-panel {
                    padding: 20px;
                }
            }

            @@media (max-width: 650px) {
                .login-container {
                    padding: 0;
                }

                .left-panel {
                    display: none;
                }

                .right-panel {
                    min-height: 100vh;
                    padding: 30px 24px;
                }

                .form-heading h2 {
                    font-size: 25px;
                }
            }
    </style>
</head>

<body>

    <div class="login-container">

        <!-- LEFT PANEL -->
        <div class="left-panel">

            <img src="/img/paintless-dent-repair%20(1).jpeg"
                 alt="Dịch vụ sửa chữa xe" />

            <div class="image-overlay"></div>

            <div class="brand">

                <div class="brand-icon">
                    <i class="fa-solid fa-truck-fast"></i>
                </div>

                <div class="brand-name">
                    NHA TRANG RESCUE
                    <span>GARAGE MANAGEMENT</span>
                </div>

            </div>

            <div class="intro-content">

                <div class="intro-tag">
                    <i class="fa-solid fa-clock"></i>
                    HỖ TRỢ CỨU HỘ 24/7
                </div>

                <h1>Đồng hành cùng bạn trên mọi hành trình.</h1>

                <p>
                    Nha Trang Rescue là hệ thống quản lý cứu hộ và sửa chữa xe thông minh,
                    kết nối khách hàng với các cửa hàng sửa chữa và đội ngũ cứu hộ
                    nhanh chóng, thuận tiện và hiệu quả.
                </p>

            </div>

        </div>

        <!-- RIGHT PANEL -->
        <div class="right-panel">

            <div class="login-form">

                <div class="form-icon">
                    <i class="fa-solid fa-user-shield"></i>
                </div>

                <div class="form-heading">

                    <div class="small-title">CHÀO MỪNG TRỞ LẠI</div>

                    <h2>Đăng nhập</h2>

                    <p>
                        Vui lòng nhập thông tin tài khoản để truy cập
                        hệ thống Nha Trang Rescue.
                    </p>

                </div>

                @if (ViewBag.Loi != null)
                {
                    <div class="alert alert-danger">
                        <i class="fa-solid fa-circle-exclamation me-2"></i>
                        @ViewBag.Loi
                    </div>
                }

                <form action="/TaiKhoan/DangNhap" method="post">

                    @Html.AntiForgeryToken()

                    <div class="mb-4">

                        <label class="form-label">Tên đăng nhập</label>

                        <div class="input-wrapper">

                            <i class="fa-solid fa-user"></i>

                            <input type="text"
                                   name="tenDangNhap"
                                   class="form-control"
                                   placeholder="Nhập tên đăng nhập"
                                   autocomplete="username"
                                   required />

                        </div>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">Mật khẩu</label>

                        <div class="input-wrapper password-wrapper">

                            <i class="fa-solid fa-lock"></i>

                            <input type="password"
                                   id="matKhau"
                                   name="matKhau"
                                   class="form-control"
                                   placeholder="Nhập mật khẩu"
                                   autocomplete="current-password"
                                   required />

                            <button type="button"
                                    class="toggle-password"
                                    onclick="togglePassword()">
                                HIỆN
                            </button>

                        </div>

                    </div>

                    <button type="submit" class="btn-login">
                        <i class="fa-solid fa-right-to-bracket me-2"></i>
                        ĐĂNG NHẬP
                    </button>

                    <div class="register-link">
                        <span>Chưa có tài khoản?</span>
                        <a href="/TaiKhoan/DangKy">Đăng ký ngay</a>
                    </div>

                </form>

                <div class="login-footer">
                    NHA TRANG RESCUE © 2026
                </div>

            </div>

        </div>

    </div>

    <script>
            function togglePassword() {
                const input = document.getElementById("matKhau");
                const button = document.querySelector(".toggle-password");

                if (input.type === "password") {
                    input.type = "text";
                    button.textContent = "ẨN";
                } else {
                    input.type = "password";
                    button.textContent = "HIỆN";
                }
            }
    </script>

</body>
</html>
