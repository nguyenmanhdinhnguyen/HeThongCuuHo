@model List<HeThongCuuHo.Models.YeuCauCuuHoLichSuViewModel>

@{
    Layout = null;
    ViewData["Title"] = "Lịch sử cứu hộ";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Lịch sử cứu hộ | NHA TRANG RESCUE</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: 'Inter', sans-serif;
                background: #f5f6fa;
                color: #263445;
            }

            /* SIDEBAR */
            .sidebar {
                width: 260px;
                height: 100vh;
                position: fixed;
                top: 0;
                left: 0;
                background: #182638;
                color: white;
                padding: 25px 17px;
                z-index: 1000;
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 5px 10px 30px;
            }

            .brand-icon {
                width: 43px;
                height: 43px;
                background: #e53935;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                flex-shrink: 0;
            }

            .brand-name {
                font-size: 15px;
                font-weight: 800;
                letter-spacing: .3px;
                line-height: 1.5;
            }

                .brand-name span {
                    color: #ff5550;
                }

            .brand-subtitle {
                color: #8290a1;
                font-size: 9px;
                letter-spacing: 1.1px;
                font-weight: 600;
            }

            .menu-label {
                color: #8290a1;
                font-size: 10px;
                font-weight: 700;
                margin: 15px 12px 10px;
                letter-spacing: 1px;
            }

            .menu-item {
                display: flex;
                align-items: center;
                gap: 13px;
                padding: 13px 14px;
                color: #bdc7d4;
                text-decoration: none;
                border-radius: 9px;
                margin-bottom: 5px;
                font-size: 12px;
                font-weight: 600;
                transition: .2s;
            }

                .menu-item:hover {
                    background: #293c53;
                    color: white;
                }

                .menu-item.active {
                    background: #e53935;
                    color: white;
                    box-shadow: 0 4px 12px rgba(229, 57, 53, .2);
                }

                .menu-item i {
                    width: 19px;
                    text-align: center;
                    font-size: 14px;
                }

            .sidebar-bottom {
                position: absolute;
                bottom: 22px;
                left: 17px;
                right: 17px;
            }

            .logout-btn {
                display: flex;
                align-items: center;
                gap: 13px;
                width: 100%;
                padding: 13px 14px;
                background: transparent;
                border: 0;
                border-radius: 9px;
                color: #bdc7d4;
                font-family: inherit;
                font-size: 12px;
                font-weight: 600;
                text-align: left;
                transition: .2s;
            }

                .logout-btn:hover {
                    background: #293c53;
                    color: #ff5550;
                }

                .logout-btn i {
                    width: 19px;
                    text-align: center;
                }

            /* MAIN */
            .main {
                margin-left: 260px;
                padding: 30px 35px;
                min-height: 100vh;
            }

            .topbar {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 28px;
            }

            .page-title {
                font-size: 23px;
                font-weight: 800;
                margin: 0;
                color: #182638;
            }

            .page-subtitle {
                color: #8994a3;
                font-size: 12px;
                margin-top: 5px;
            }

            .user-info {
                display: flex;
                align-items: center;
                gap: 12px;
                background: white;
                padding: 9px 15px;
                border-radius: 12px;
                border: 1px solid #edf0f4;
                box-shadow: 0 3px 12px rgba(0,0,0,.025);
            }

            .avatar {
                width: 38px;
                height: 38px;
                background: #fff0ef;
                color: #e53935;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
            }

            .user-name {
                font-size: 12px;
                font-weight: 700;
                color: #263445;
            }

            .user-role {
                font-size: 10px;
                color: #929ba8;
                margin-top: 3px;
            }

            /* WELCOME BANNER */
            .welcome {
                background: linear-gradient(115deg, #e53935, #bd2525);
                border-radius: 16px;
                padding: 27px 30px;
                color: white;
                position: relative;
                overflow: hidden;
                margin-bottom: 27px;
                box-shadow: 0 8px 22px rgba(229, 57, 53, .13);
            }

                .welcome::after {
                    content: "\f1da";
                    font-family: "Font Awesome 6 Free";
                    font-weight: 900;
                    position: absolute;
                    right: 55px;
                    top: 10px;
                    font-size: 110px;
                    color: rgba(255,255,255,.09);
                }

                .welcome h2 {
                    font-size: 21px;
                    font-weight: 800;
                    margin-bottom: 8px;
                    position: relative;
                    z-index: 1;
                }

                .welcome p {
                    color: #ffe1e0;
                    font-size: 12px;
                    margin: 0;
                    position: relative;
                    z-index: 1;
                }

            /* BUTTON */
            .btn-create {
                display: inline-flex;
                align-items: center;
                gap: 9px;
                background: white;
                color: #e53935;
                padding: 11px 17px;
                border-radius: 8px;
                text-decoration: none;
                font-size: 11px;
                font-weight: 800;
                transition: .2s;
            }

                .btn-create:hover {
                    background: #fff0ef;
                    color: #bd2525;
                    transform: translateY(-2px);
                }

            /* SECTION */
            .section-title {
                font-size: 15px;
                font-weight: 800;
                color: #263445;
                margin-bottom: 16px;
            }

            /* HISTORY CARD */
            .history-card {
                background: white;
                border: 1px solid #edf0f4;
                border-radius: 13px;
                padding: 22px;
                margin-bottom: 15px;
                box-shadow: 0 3px 12px rgba(0,0,0,.025);
                transition: .2s;
            }

                .history-card:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 7px 18px rgba(0,0,0,.05);
                }

            .request-id {
                color: #e53935;
                font-size: 13px;
                font-weight: 800;
            }

            .request-time {
                color: #929ba8;
                font-size: 10px;
                margin-top: 6px;
            }

            .status {
                display: inline-block;
                padding: 7px 12px;
                border-radius: 20px;
                font-size: 10px;
                font-weight: 750;
                white-space: nowrap;
            }

            .status-wait {
                background: #fff3cd;
                color: #856404;
            }

            .status-process {
                background: #eaf3ff;
                color: #3478c7;
            }

            .status-done {
                background: #e8f8ef;
                color: #239653;
            }

            .status-cancel {
                background: #fee2e2;
                color: #b91c1c;
            }

            .history-card hr {
                border-color: #edf0f4;
                opacity: 1;
                margin: 17px 0;
            }

            .info-row {
                margin-top: 13px;
                color: #566477;
                font-size: 11px;
                line-height: 1.7;
                overflow-wrap: anywhere;
            }

                .info-row i {
                    width: 22px;
                    color: #e53935;
                }

                .info-row strong {
                    color: #263445;
                    font-weight: 700;
                }

            /* EMPTY STATE */
            .empty-state {
                background: white;
                border: 1px solid #edf0f4;
                padding: 55px 20px;
                border-radius: 13px;
                text-align: center;
                box-shadow: 0 3px 12px rgba(0,0,0,.025);
            }

                .empty-state i {
                    font-size: 48px;
                    color: #cbd5e1;
                    margin-bottom: 20px;
                }

                .empty-state h5 {
                    font-size: 15px;
                    font-weight: 800;
                    color: #263445;
                }

                .empty-state p {
                    color: #929ba8;
                    font-size: 12px;
                }

            .alert {
                font-size: 12px;
                border-radius: 10px;
            }

            /* FOOTER */
            .footer {
                text-align: center;
                color: #a0a8b3;
                font-size: 10px;
                padding: 25px 0 5px;
            }

            /* RESPONSIVE */
            @@media (max-width: 900px) {
                .sidebar {
                    width: 70px;
                    padding: 20px 9px;
                }

                .brand {
                    justify-content: center;
                    padding: 5px 0 30px;
                }

                .brand-name,
                .brand-subtitle,
                .menu-label,
                .menu-item span,
                .logout-btn span,
                .sidebar-bottom {
                    display: none;
                }

                .menu-item {
                    justify-content: center;
                    padding: 14px 5px;
                }

                    .menu-item i {
                        font-size: 17px;
                    }

                .main {
                    margin-left: 70px;
                    padding: 22px;
                }
            }

            @@media (max-width: 600px) {
                .main {
                    padding: 15px;
                }

                .topbar {
                    align-items: flex-start;
                    gap: 10px;
                }

                .page-title {
                    font-size: 19px;
                }

                .user-info {
                    padding: 7px;
                }

                    .user-info .user-text {
                        display: none;
                    }

                .welcome {
                    padding: 22px;
                }

                    .welcome h2 {
                        font-size: 18px;
                    }

                    .welcome::after {
                        right: 10px;
                        top: 35px;
                        font-size: 70px;
                    }

                .history-card {
                    padding: 17px;
                }

                .history-header {
                    align-items: flex-start;
                }
            }
    </style>
</head>

<body>

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <div class="brand">
            <div class="brand-icon">
                <i class="fa-solid fa-truck-fast"></i>
            </div>

            <div>
                <div class="brand-name">
                    NHA TRANG <span>RESCUE</span>
                </div>
                <div class="brand-subtitle">CUSTOMER MANAGEMENT</div>
            </div>
        </div>

        <div class="menu-label">KHÁCH HÀNG</div>

        <a href="/KhachHang/Index" class="menu-item">
            <i class="fa-solid fa-house"></i>
            <span>Trang chủ</span>
        </a>

        <a href="/YeuCauCuuHo/Create" class="menu-item">
            <i class="fa-solid fa-truck-medical"></i>
            <span>Yêu cầu cứu hộ</span>
        </a>

        <a href="/YeuCauCuuHo/Index" class="menu-item active">
            <i class="fa-solid fa-clock-rotate-left"></i>
            <span>Lịch sử cứu hộ</span>
        </a>

        <a href="/PhuongTien/Index" class="menu-item">
            <i class="fa-solid fa-car"></i>
            <span>Phương tiện của tôi</span>
        </a>

        <div class="menu-label mt-4">TÀI KHOẢN</div>

        <a href="/TaiKhoan/ThongTin" class="menu-item">
            <i class="fa-solid fa-user"></i>
            <span>Thông tin cá nhân</span>
        </a>

        <div class="sidebar-bottom">
            <form asp-controller="TaiKhoan"
                  asp-action="DangXuat"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit" class="logout-btn">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    <span>Đăng xuất</span>
                </button>

            </form>
        </div>

    </aside>

    <!-- MAIN CONTENT -->
    <main class="main">

        <!-- TOPBAR -->
        <div class="topbar">

            <div>
                <h1 class="page-title">Lịch sử cứu hộ</h1>
                <div class="page-subtitle">
                    Theo dõi tình trạng các yêu cầu cứu hộ của bạn
                </div>
            </div>

            <div class="user-info">
                <div class="avatar">
                    <i class="fa-solid fa-user"></i>
                </div>

                <div class="user-text">
                    <div class="user-name">Khách hàng</div>
                    <div class="user-role">NHA TRANG RESCUE</div>
                </div>
            </div>

        </div>

        <!-- WELCOME BANNER -->
        <section class="welcome">

            <h2>Quản lý yêu cầu cứu hộ</h2>

            <p>
                Xem lại các yêu cầu đã gửi và cập nhật tình trạng hỗ trợ phương tiện của bạn.
            </p>

        </section>

        <!-- PAGE ACTIONS -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

            <div>
                <h5 class="section-title mb-1">Danh sách yêu cầu</h5>
                <div class="text-muted" style="font-size:11px">
                    Các yêu cầu cứu hộ được gửi từ tài khoản của bạn
                </div>
            </div>

            <a href="/YeuCauCuuHo/Create" class="btn-create">
                <i class="fa-solid fa-plus"></i>
                TẠO YÊU CẦU MỚI
            </a>

        </div>

        @if (TempData["ThongBao"] != null)
        {
            <div class="alert alert-success">
                <i class="fa-solid fa-circle-check me-2"></i>
                @TempData["ThongBao"]
            </div>
        }

        @if (Model == null || !Model.Any())
        {
            <div class="empty-state">

                <i class="fa-solid fa-truck-fast"></i>

                <h5>Chưa có yêu cầu cứu hộ</h5>

                <p>
                    Bạn chưa gửi yêu cầu cứu hộ nào.
                    Hãy tạo yêu cầu để được hỗ trợ khi phương tiện gặp sự cố.
                </p>

                <a href="/YeuCauCuuHo/Create" class="btn-create">
                    <i class="fa-solid fa-plus me-2"></i>
                    GỬI YÊU CẦU NGAY
                </a>

            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                var trangThai = item.TrangThai ?? "Chờ tiếp nhận";

                var statusClass = trangThai switch
                {
                    "Chờ tiếp nhận" => "status-wait",
                    "Đang xử lý" => "status-process",
                    "Đang cứu hộ" => "status-process",
                    "Hoàn thành" => "status-done",
                    "Đã hoàn thành" => "status-done",
                    "Đã hủy" => "status-cancel",
                    _ => "status-wait"
                };

                <div class="history-card">

                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 history-header">

                        <div>
                            <div class="request-id">
                                YÊU CẦU #@item.MaYC
                            </div>

                            <div class="request-time">
                                <i class="fa-regular fa-clock me-1"></i>
                                @(item.ThoiGianYeuCau?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa có thời gian")
                            </div>
                        </div>

                        <span class="status @statusClass">
                            @trangThai
                        </span>

                    </div>

                    <hr>

                    <div class="row">

                        <div class="col-md-6">

                            <div class="info-row">
                                <i class="fa-solid fa-car"></i>
                                <strong>Phương tiện:</strong>
                                @item.TenPhuongTien
                            </div>

                            <div class="info-row">
                                <i class="fa-solid fa-id-card"></i>
                                <strong>Biển số:</strong>
                                @item.BienSo
                            </div>

                            <div class="info-row">
                                <i class="fa-solid fa-location-dot"></i>
                                <strong>Địa điểm:</strong>
                                @item.DiaDiem
                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="info-row">
                                <i class="fa-solid fa-truck-fast"></i>
                                <strong>Hình thức:</strong>

                                @(item.HinhThucHoTro == "SuaTaiCho"
                                    ? "Sửa chữa tại chỗ"
                                    : item.HinhThucHoTro == "CuuHoVeTiem"
                                        ? "Cứu hộ về tiệm"
                                        : "Chưa xác định")
                            </div>

                            <div class="info-row">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                <strong>Ưu tiên:</strong>
                                @(item.MucDoUuTien ?? "Bình thường")
                            </div>

                            <div class="info-row">
                                <i class="fa-solid fa-comment"></i>
                                <strong>Sự cố:</strong>

                                @(string.IsNullOrWhiteSpace(item.MoTaSuCo)
                                    ? "Không có mô tả"
                                    : item.MoTaSuCo)
                            </div>

                        </div>

                    </div>

                </div>
            }
        }

        <div class="footer">
            © 2026 NHA TRANG RESCUE. ALL RIGHTS RESERVED.
        </div>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
